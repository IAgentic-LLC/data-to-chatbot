# Local-development settings only. Episode 9 replaces every secret and turns real authentication on.
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://pipeline:pipeline@db:5432/airflow
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api:8080/execution/
AIRFLOW__API_AUTH__JWT_SECRET=dev-only-change-me-in-episode-8
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=True
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=10
PYTHONPATH=/opt/airflow/project
EMBED_PROVIDER=fastembed
FASTEMBED_CACHE_PATH=/opt/airflow/fastembed_cache
DATABASE_URL=postgresql://pipeline:pipeline@db:5432/pipeline
S3_ENDPOINT=http://lake:8333
SOURCES_DIR=/opt/airflow/project/data/sources

# Episode 5B: the graph database (only used when GRAPH_ENABLED=1; start it with: docker compose --profile graph up -d graph)
GRAPH_ENABLED=0
NEO4J_URI=bolt://graph:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dropline-local-pw
